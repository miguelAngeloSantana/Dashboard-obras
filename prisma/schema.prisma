generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoLancamento {
  MATERIAL
  MAO_DE_OBRA
  EQUIPAMENTO
  SERVICO
  OUTRO
}

model Obra {
  id             String    @id @default(uuid())
  nome           String
  endereco       String
  cep            String?
  clienteNome    String
  clientTel      String?
  dataInicio     DateTime
  dataFim        DateTime?
  status         String    @default("Planejando")
  progresso_pct  Int
  orcamentoTotal Decimal?  @db.Decimal(12, 2)

  estoque     Estoque[]
  lancamentos Lancamento[]
  etapa       Etapa[]
  pedidos     Pedido[]

  @@index([status])
  @@index([dataFim])
}

model Material {
  id           String  @id
  nomeMaterial String
  unidade      String
  categoria    String?

  estoque    Estoque[]
  itemPedido ItemPedido[]
}

model Estoque {
  id            String  @id @default(uuid())
  qtdPlanejada  Decimal @db.Decimal(10, 3)
  qtdDisponivel Decimal @default(0) @db.Decimal(10, 3)
  qtdMinima     Decimal @default(0) @db.Decimal(10, 3) // Abaixo disso, alerta 

  obraId     String
  materialId String

  obra     Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  movimentacao Movimentacao[]

  @@unique([obraId, materialId])
  @@index([obraId])
  @@index([qtdDisponivel])
}

model Etapa {
  id             String    @id @default(uuid())
  nome           String
  ordem          Int
  dataInicio     DateTime?
  dataFimPrev    DateTime?
  dataFim        DateTime?
  progressoPct   Int       @default(0)
  status         String    @default("Pendente")
  custoOrcamento Decimal   @db.Decimal(12, 2)
  pesoFixo       Int
  pesoFixoPadrao Decimal   @db.Decimal(5, 4) //0.2500 25% padrão do sistema
  pesoOrcamento  Decimal?  @db.Decimal(5, 4) // calc -> custoEtapa / orcamentoTotal
  custoEtapa     Int?      @default(0) // null até a obra ter orçamento completo

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id])

  subEtapa SubEtapasDB[]

  // @@unique([obraId])
  @@index([obraId])
}

model Movimentacao {
  id         String   @id @default(uuid())
  estoqueId  String
  pedidoId   String?
  tipo       String
  quantidade Decimal  @db.Decimal(10, 3)
  dataHora   DateTime
  origem     String
  qtdAntes   Decimal  @db.Decimal(10, 3)
  atdDepois  Decimal  @db.Decimal(10, 3)
  observacao String?

  estoque Estoque @relation(fields: [estoqueId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([estoqueId])
  @@index([pedidoId])
}

model Lancamento {
  id          String         @id @default(uuid())
  obraId      String
  etapaId     String?
  tipo        TipoLancamento
  valor       Decimal        @db.Decimal(12, 2)
  data        DateTime
  descricao   String?
  notaFiscal  String?
  comprovante String?

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId, data])
  @@index([obraId, tipo])
}

model Pedido {
  id              String    @id @default(uuid())
  obraId          String
  fornecedorId    String
  dataPedido      DateTime  @default(now())
  dataPrevEntrega DateTime?
  status          String    @default("Avaliando")
  valorTotal      Decimal?  @db.Decimal(12, 2)

  obra         Obra           @relation(fields: [obraId], references: [id])
  movimentacao Movimentacao[]
  itens        ItemPedido[]
  fornecedor   Fornecedor     @relation(fields: [fornecedorId], references: [id])

  @@index([obraId, status])
  @@index([fornecedorId])
  @@index([dataPrevEntrega])
}

model ItemPedido {
  id         String   @id @default(uuid())
  pedidoId   String
  materialId String
  quantidade Decimal  @db.Decimal(10, 3)
  precoUnit  Decimal? @db.Decimal(10, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([pedidoId, materialId])
}

model Fornecedor {
  id        String  @id @default(uuid())
  nome      String
  cnpj      String? @unique
  telefone  String
  email     String
  endereco  String
  categoria String
  ativo     Boolean @default(true)

  pedidos Pedido[]

  @@index([ativo])
}

model SubEtapasDB {
  id      String @id @default(uuid())
  etapaId String
  nome    String
  ordem   Int

  progressoPct Int  @default(0)
  pesoManual   Int? @default(0)

  etapa Etapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)
}
